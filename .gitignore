# dependencies
node_modules/

# TypeScript incremental build info
*.tsbuildinfo

# electron-vite build output
out/
# packaged installers (when electron-builder/forge is wired)
dist/
release/

# Generated from src/renderer/src/app.mu by `npm run compile:mu` (the mural
# CLI) before Vite bundles it — a build artifact, not source.
*.mu.js

# Local performance-trace captures (Chrome DevTools JSON) — debugging
# artifacts, not source.
debug/

# Local npm auth/registry config (Verdaccio token) — never commit.
.npmrc
e2e/.artifacts/

# SDD scratch workspace
.superpowers/
