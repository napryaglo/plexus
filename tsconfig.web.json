{
  // Web side: the renderer. `@visualisation-sub/mural/*` type-checks against
  // the built dist `.d.ts` (via the file:../.. dependency) — the same public
  // surface an external consumer sees. The renderer is bundled by Vite, which
  // resolves the runtime `.js` (see electron.vite.config resolve.conditions).
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.mu",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "allowJs": true,
    "types": ["electron-vite/node"]
  }
}
